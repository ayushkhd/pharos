# Pylint configuration for Pharos.
#
# Derived from Google's published pylintrc
# (https://google.github.io/styleguide/pylintrc) with three deliberate
# changes:
#   * 2-space indentation, as used inside google3 (the public guide says 4).
#   * Python 2 compatibility messages removed; pylint 4 no longer knows them.
#   * The docparams extension is enabled, so a docstring that omits an
#     argument or a raised exception is a lint error.
#
# Refactor-class (R) messages stay disabled, as in Google's config: code
# structure is a review concern, not a linter concern.

[MAIN]
ignore=third_party
persistent=no
load-plugins=pylint.extensions.docparams
jobs=4
unsafe-load-any-extension=no

[MESSAGES CONTROL]
disable=R,
        abstract-method,
        arguments-differ,
        attribute-defined-outside-init,
        c-extension-no-member,
        fixme,
        global-statement,
        implicit-str-concat,
        import-error,
        import-self,
        locally-disabled,
        no-member,
        no-name-in-module,
        signature-differs,
        suppressed-message,
        trailing-newlines,
        unnecessary-pass,
        useless-else-on-loop,
        useless-suppression,
        wrong-import-order

[REPORTS]
output-format=text
reports=no
score=no

[BASIC]
good-names=main,_
property-classes=abc.abstractproperty,functools.cached_property
function-rgx=^(?:(?P<exempt>setUp|tearDown|setUpModule|tearDownModule)|(?P<camel_case>_?[A-Z][a-zA-Z0-9]*)|(?P<snake_case>_?[a-z][a-z0-9_]*))$
variable-rgx=^[a-z][a-z0-9_]*$
const-rgx=^(_?[A-Z][A-Z0-9_]*|__[a-z0-9_]+__|_?[a-z][a-z0-9_]*)$
attr-rgx=^_{0,2}[a-z][a-z0-9_]*$
argument-rgx=^[a-z][a-z0-9_]*$
class-attribute-rgx=^(_?[A-Z][A-Z0-9_]*|__[a-z0-9_]+__|_?[a-z][a-z0-9_]*)$
inlinevar-rgx=^[a-z][a-z0-9_]*$
class-rgx=^_?[A-Z][a-zA-Z0-9]*$
module-rgx=^(_?[a-z][a-z0-9_]*|__init__)$
method-rgx=(?x)^(?:(?P<exempt>_[a-z0-9_]+__|runTest|setUp|tearDown|setUpTestCase|tearDownTestCase|setupSelf|tearDownClass|setUpClass|(test|assert)_*[A-Z0-9][a-zA-Z0-9_]*|next)|(?P<camel_case>_{0,2}[A-Z][a-zA-Z0-9_]*)|(?P<snake_case>_{0,2}[a-z][a-z0-9_]*))$
no-docstring-rgx=(__.*__|main|test.*|.*test|.*Test)$
docstring-min-length=12

[PARAMETER_DOCUMENTATION]
accept-no-param-doc=no
accept-no-raise-doc=no
# The style guide lets a docstring omit its Returns section when the
# summary line itself starts with "Returns"; pylint cannot tell those
# apart from genuinely undocumented returns, so return docs are advisory.
accept-no-return-doc=yes
accept-no-yields-doc=yes
default-docstring-type=google

[TYPECHECK]
contextmanager-decorators=contextlib.contextmanager
ignored-classes=optparse.Values,thread._local,_thread._local

[FORMAT]
max-line-length=80
ignore-long-lines=(?x)(
  ^\s*(\#\ )?<?https?://\S+>?$|
  ^\s*(from\s+\S+\s+)?import\s+.+$)
single-line-if-stmt=yes
max-module-lines=99999
indent-string='  '
indent-after-paren=4

[MISCELLANEOUS]
notes=TODO

[STRING]
check-quote-consistency=yes

[VARIABLES]
init-import=no
dummy-variables-rgx=^\*{0,2}(_$|unused_|dummy_)
callbacks=cb_,_cb
redefining-builtins-modules=functools

[LOGGING]
logging-modules=logging

[SIMILARITIES]
min-similarity-lines=4
ignore-comments=yes
ignore-docstrings=yes
ignore-imports=no

[CLASSES]
defining-attr-methods=__init__,__new__,setUp
exclude-protected=_asdict,_fields,_replace,_source,_make
valid-classmethod-first-arg=cls,class_
valid-metaclass-classmethod-first-arg=mcs
